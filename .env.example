# ==============================================================================
# Family Milk Account - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS OR COPY PRODUCTION SECRETS INTO THIS TEMPLATE.
# Copy this file to .env in local development. For production (e.g. Render),
# configure these environment variables in your hosting provider's dashboard.

# ------------------------------------------------------------------------------
# 1. Server Settings
# ------------------------------------------------------------------------------
# Port on which the Express server listens (default: 5000 locally, 10000 on Render).
PORT=5000

# Application environment ('development' | 'production' | 'test').
NODE_ENV=development

# Timezone for consistent midnight cutoffs and Indian milk ledger accounting.
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Generic PostgreSQL connection URL.
# If hosted on Supabase, use the Session Pooler (port 5432) or Transaction Pooler (port 6543).
# If your database password contains special characters (@, :, %, #, etc.), URL-encode them.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Enable SSL for secure database connections (mandatory for Supabase and production).
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Cryptographically secure random secret of at least 32 characters used to sign JWT access tokens.
# To generate a secure secret locally, run:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_bytes

# Short-lived access token duration (default: 15m).
# The client silently refreshes expired access tokens using the httpOnly refresh cookie.
JWT_EXPIRES_IN=15m

# Persistent sliding-window refresh token lifetime in days (default: 365).
# Refresh tokens are securely stored in httpOnly, SameSite=Lax cookies ('milk_refresh_token'),
# hashed in PostgreSQL with SHA-256, rotated on refresh with a 30s concurrent-tab grace period,
# and feature automatic replay-attack revocation upon token reuse.
REFRESH_TOKEN_EXPIRES_IN_DAYS=365

# ------------------------------------------------------------------------------
# 4. Optional Initial Database Bootstrap (Manual Initial Setup Only)
# ------------------------------------------------------------------------------
# WARNING: These variables are ONLY used when explicitly executing 'npm run db:seed'
# to populate an empty, freshly-created database.
# NEVER run 'npm run db:seed' on an existing production family database!
INITIAL_FAMILY_NAME="Our Family Milk Account"
INITIAL_DEFAULT_RATE_RUPEES=56
INITIAL_ADMIN_PHONE=REPLACE_WITH_ADMIN_PHONE
INITIAL_ADMIN_NAME="Family Admin"
INITIAL_ADMIN_PIN=REPLACE_WITH_ADMIN_PIN
