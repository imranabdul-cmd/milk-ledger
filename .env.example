# ==========================================
# Family Milk Account - Environment Configuration Template
# ==========================================
# DO NOT COMMIT REAL CREDENTIALS.
# Copy this file to .env in local development.

# Server Settings
PORT=5000
NODE_ENV=development

# Database (PostgreSQL hosted on Supabase - Session Pooler, Port 5432)
# Host: aws-0-ap-south-1.pooler.supabase.com (Mumbai, India)
# Replace REPLACE_WITH_DATABASE_PASSWORD with your actual Supabase database password.
# If your password contains special characters (@, :, %, #, etc.), URL-encode them.
DATABASE_URL=postgresql://postgres.ivwjoqhnvjpfzofxbihf:REPLACE_WITH_DATABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Set to 'true' if connecting with SSL (required for Supabase)
DATABASE_SSL=true

# Security & Authentication
# Generate a strong random key of at least 32 bytes:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_bytes
JWT_EXPIRES_IN=36500d

# Timezone (Fixed to Asia/Kolkata for accurate Indian Milk accounting)
TZ=Asia/Kolkata

# Initial Family Bootstrap (For initial deployment and 'npm run db:seed')
# Configure with your actual family settings before seeding.
INITIAL_FAMILY_NAME="Our Family Milk Account"
INITIAL_DEFAULT_RATE_RUPEES=56
INITIAL_ADMIN_PHONE=REPLACE_WITH_ADMIN_PHONE
INITIAL_ADMIN_NAME="Family Admin"
INITIAL_ADMIN_PIN=REPLACE_WITH_ADMIN_PIN
